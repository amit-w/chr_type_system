% DOC doc module
:- module(errors, [init/0, report_error/1, collect/1]).
:- use_module(lists).

% ==========================================================================
% Error accumulation
% ==========================================================================

:- chr_constraint
    init,
    report_error(any),
    collect(list(any)),
    errors(list(any)).

init <=> errors([]).

accumulate @ report_error(E), errors(Es) <=> errors([E | Es]).
collect_es @ collect(Out), errors(Es) <=> Out is reverse(Es).

