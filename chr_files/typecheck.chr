% A Curry-style simply-typed lambda-calculus type inferencer, written
% entirely in CHR.
%
% This is the CHR half of an end-to-end embedding example: the Haskell
% driver in examples/stlc/Main.hs encodes lambda terms as CHR terms,
% tells `typecheck/2`, and decodes the inferred type (or the type errors)
% back into Haskell values through YCHR.Convert.
%
% Type inference *is* constraint solving, so it maps directly onto CHR:
%   - a fresh type variable is just an unbound logical variable, created
%     for free whenever a rule body mentions a new variable;
%   - unification of type structures is a handful of simplification rules;
%   - the typing context and the accumulated errors live in the store.
%
% The object language (`expr`, built by the Haskell side):
%   evar(Name)           a variable reference         (Name is a string)
%   lam(Name, Body)      an *unannotated* lambda      (argument type inferred)
%   app(F, X)            application
%   let(Name, Val, Body) a let binding                (Name is a string)
%   lit_int(N)           an integer literal
%   add(A, B)            integer addition             (forces both sides to int)
%
% The type language (`ty`, below):
%   tint             the base type of integers
%   arrow(S, T)      a function type
%   tvar(N)          a numbered type variable, produced only at the very
% TODO re-doc next lines
%                    end by `number_vars` so that a polymorphic result
%                    such as `arrow(tvar(0), tvar(0))` can be printed and
%                    decoded with its sharing intact.

:- module(stlc, [typecheck/3, type(expr/0)]).
:- use_module(library(prelude)).
:- use_module(library(lists)).

% The object language is *host-supplied data*: the Haskell driver builds
% these compounds and passes them in. It is a declared type, and it is
% exported, precisely so that goal arguments built by the host are
% canonicalized to `stlc:evar`, `stlc:lam`, ... — the same qualified
% form the rule heads below were compiled to.
%
% The variable node is `evar`, not `var`: the prelude declares a
% `var/1` function, and a data constructor may not share a bare name
% with a visible function (YCHR-20020). The guards below want that
% prelude function, so the constructor is the side that moves.
:- chr_type expr ---> evar(string, var_annotation)
                    ; lam(string, ty, expr)
                    ; app(expr, expr)
                    ; let(string, expr, expr)
                    ; lit_int(int)
                    ; add(expr, expr).
:- chr_type var_annotation ---> mono_var ; poly_var(list(ty)).

% The type language is built and matched entirely inside this module.
% TODO update next line
% `tvar` is produced only by `number_vars`, at the very end.
% `tvar` is `tvar(Level, Number)`
:- chr_type ty ---> tint ; arrow(ty, ty) ; tvar(int, int).

:- chr_type bind_mode ---> mono ; poly(generalization_domain).

% A typing-context cell. `Env` is a list of these.
:- chr_type binding ---> bind(string, bind_mode, ty).

:- opaque_type generalization_domain.
:- opaque_type instantiation_domain.

% The two possible results of inference (decoded on the Haskell side).
:- chr_type tc_result ---> ok(ty) ; type_error(list(any)).

% Entry point. `Result` is unified with `ok(Type)` when inference
% succeeds, or `type_error(Errors)` when it does not.
:- chr_constraint
    typecheck(expr, ty, list(any)),
    typeof(generalization_domain, list(binding), expr, ty),
    associate_var(ty, generalization_domain),
    associate_vars(list(ty), generalization_domain),
    lookup_ty(list(binding), string, ty, var_annotation),
    unify_ty(ty, ty),
    generalization_domain(generalization_domain, int),
    gd_args(generalization_domain, list(ty)),
    % TODO type this
    let_type_args/3,
    number_domain(generalization_domain, int, int, list(ty)),
    instantiate_ty(instantiation_domain, ty, ty),
    instantiation_domain(instantiation_domain, var_annotation, generalization_domain),
    bind_ty(ty, ty),
    future_assign_tvars(list(ty), int),
    assign_tvars(list(ty), int, int),
    finish,
    report_error(any),
    phase_dispose_GDs,
    phase_dispose_IDs,
    phase_number_vars,

    dispose_GD/3,
    gd_arg_count/2,
    dispose_ID/4,
    % start_let_type_args,
    errors(any),
    collect(any).

% ==========================================================================
% Driver
% ==========================================================================
%
% Seed an empty error accumulator, infer the type of the expression in the
% empty context, then read the accumulated errors back out and build the
% result. Body goals run to completion left-to-right, so by the time
% `collect` fires every error `typeof` could raise has already landed in
% `errors`.

typecheck(Expr, T, Es) <=>
    errors([]),
    generalization_domain(TopGD, 0),
    associate_var(T, TopGD),
    typeof(TopGD, [], Expr, T),
    collect(Es),
    finish.

% TODO if we return partially annotated terms, it makes sense to also return partially annotated types.
% (cont.) typecheck's signature should probably be typecheck(Expr, Type, Errors) and the haskell side will handle it
% No errors: ground the residual type variables and report the type.
finish <=> phase_dispose_GDs, phase_dispose_IDs, phase_number_vars.

% ==========================================================================
% Levels: associate_var(Var, Level), associate_vars(Vars, Level)
% ==========================================================================
% 
% Every type unification variable (and only them) is associated to a single GD,
% that has the smallest level, from those that it were associated to.
%
% `associate_vars` is used to associate a GD to multiple unification variables.

associate_var_only_variable @ associate_var(V, _) <=> nonvar(V) | true.
associate_var_singleton     @ associate_var(V, GD) \ associate_var(V, GD) <=> true.
% TODO create a gd_descendant constraint instead
associate_var_smallest      @ associate_var(V, GDLow), generalization_domain(GDLow, Low), generalization_domain(GDHigh, High) \ associate_var(V, GDHigh) <=> High >= Low | true.

associate_vars_peel @ associate_vars([V | Vs], Level) <=> associate_var(V, Level), associate_vars(Vs, Level).
associate_vars_end  @ associate_vars([], _) <=> true.

% ==========================================================================
% Typing rules: typeof(GD, Env, Expr, T)
% ==========================================================================
%
% Env is an association list of `bind(Name, Type)` cells. Each rule is a
% simplification: the `typeof` goal is consumed and replaced by the
% subgoals that decompose it. Variables first mentioned in a body (A, B,
% TF, TA below) are fresh type variables.

typeof_int @ typeof(_, _, lit_int(_), T) <=> unify_ty(T, tint).

typeof_add @ typeof(GD, Env, add(A, B), T) <=>
    associate_var(TA, GD),
    typeof(GD, Env, A, TA),
    associate_var(TB, GD),
    typeof(GD, Env, B, TB),
    unify_ty(TA, tint),
    unify_ty(TB, tint),
    unify_ty(T, tint).

typeof_var @ typeof(_, Env, evar(X, VA), T) <=> lookup_ty(Env, X, T, VA).

% `Env2 = [...]` introduces the fresh argument-type variable A: a bare
% unbound variable may not first appear nested inside a constraint tell
% (whose arguments are evaluated), but `=` is pure unification and binds
% the new variables in its operands.
typeof_lam @ typeof(GD, Env, lam(X, A, Body), T) <=>
    Env2 = [bind(X, mono, A) | Env],
    associate_var(B, GD),
    typeof(GD, Env2, Body, B),
    unify_ty(T, arrow(A, B)).

typeof_app @ typeof(GD, Env, app(F, Arg), T) <=>
    associate_var(TF, GD),
    typeof(GD, Env, F, TF),
    associate_var(TA, GD),
    typeof(GD, Env, Arg, TA),
    unify_ty(TF, arrow(TA, T)).

typeof_let @ generalization_domain(GD, Level) \ typeof(GD, Env, let(X, Val, Body), T) <=>
    % TODO avoid having to deal with Level in this rule by having a `nested_gd` rule.
    NestedLevel is Level + 1,
    generalization_domain(NestedGD, NestedLevel),
    associate_var(A, NestedGD),
    typeof(NestedGD, Env, Val, A),
    Env2 = [bind(X, poly(NestedGD), A) | Env],
    typeof(GD, Env2, Body, T).

% ==========================================================================
% Context lookup: lookup_ty(Env, Name, T, VA)
% ==========================================================================
%
% The three rules are tried top-to-bottom. In the first head the repeated
% `X` becomes an implicit equality guard, so it fires only when the head
% binding's name matches; otherwise the general second rule skips a cell.
% Reaching the empty list means the variable was never bound.

lookup_mono @ lookup_ty([bind(X, mono, Ty) | _], X, T, VA) <=> unify_ty(T, Ty), VA = mono_var.
lookup_poly @ lookup_ty([bind(X, poly(GD), Ty) | _], X, T, VA) <=>
    instantiation_domain(D, VA, GD),
    instantiate_ty(D, T, Ty).
lookup_skip @ lookup_ty([bind(_, _, _) | Rest], X, T, VA) <=> lookup_ty(Rest, X, T, VA).
lookup_miss @ lookup_ty([], X, _, VA) <=> report_error(quote(unbound_variable(X))).

% ==========================================================================
% Type unification: unify_ty(T1, T2)
% ==========================================================================
%
% A structural unifier that binds unbound type variables but *never* lets a
% raw `=` fail: an incompatible pair of concrete types is reported as an
% error instead of aborting the whole run. Variable cases bind directly
% (one side is always an unbound variable, so `=` cannot fail there).

unify_int   @ unify_ty(tint, tint) <=> true.
unify_arrow @ unify_ty(arrow(A1, R1), arrow(A2, R2)) <=>
    unify_ty(A1, A2),
    unify_ty(R1, R2).

unify_vv @ unify_ty(T1, T2) <=> var(T1), var(T2) | T1 = T2.
unify_vt @ unify_ty(T1, T2) <=> var(T1), nonvar(T2) | bind_ty(T1, T2).
unify_tv @ unify_ty(T1, T2) <=> nonvar(T1), var(T2) | bind_ty(T2, T1).
unify_bad @ unify_ty(T1, T2) <=> nonvar(T1), nonvar(T2) |
    report_error(quote(mismatch(T1, T2))).

% Bind a variable to a type, guarding against the infinite types that
% self-application (`lam(x, app(evar(x), evar(x)))`) would otherwise create.
bind_occurs @ bind_ty(V, Ty) <=> occurs(V, Ty) |
    report_error(quote(infinite_type(V, Ty))).
bind_ok     @ associate_var(V, GD) \ bind_ty(V, Ty) <=>
    associate_vars(term_variables(Ty), GD),
    V = Ty.

% ==========================================================================
% Instantiation: instantiate_ty(D, T1, T2)
% ==========================================================================
%
% Instantiate T2 to T1 in instantiation-domain D.
% The instantiation-domain is used to make sure that an instantiated variable always instantiate to the same type.
% instantiation_domain(D, Level) sets the associate_var of the domain.   % TODO update this line
inst_tint       @ instantiate_ty(D, T, tint) <=> unify_ty(T, tint).
inst_arrow      @ instantiation_domain(D, _, _), associate_var(T, T_GD) \ instantiate_ty(D, T, arrow(A, B)) <=>
    associate_var(TA, T_GD),
    instantiate_ty(D, TA, A),
    associate_var(TB, T_GD),
    instantiate_ty(D, TB, B),
    unify_ty(T, arrow(TA, TB)).
% TODO [collect] re-introduce inst_error, after making sure that Ty=tvar(_, _) is impossible
% (TODO) idea is: collect_gd (collects gd_args) -> start_let_type_args -> number_gd_args (which will use assign_tvars)
inst_error      @ instantiate_ty(_, _, Ty) <=> nonvar(Ty) | report_error(quote(inst_non_var(Ty))).
inst_direct     @ instantiation_domain(D, _, GD), generalization_domain(GD, DomainLevel), associate_var(V, VarDomain), generalization_domain(VarDomain, VarLevel) \
    instantiate_ty(D, T, V) <=>
    DomainLevel > VarLevel |
    V = T.
% TODO reorder so the error case will be last
inst_level_high @ instantiation_domain(D, _, GD), generalization_domain(GD, DomainLevel), associate_var(V, VarDomain), generalization_domain(VarDomain, VarLevel) \
    instantiate_ty(D, T, V) <=>
    DomainLevel < VarLevel |
    report_error(quote(inst_level_high)).
inst_singleton  @ instantiate_ty(D, T1, V) \ instantiate_ty(D, T2, V) <=>
    unify_ty(T1, T2).

% ==========================================================================
% Error accumulation
% ==========================================================================
%
% Errors are prepended, so a program with several of them collects them in
% reverse (most-recent-first) order. That is invisible here — every demo
% raises at most one — but worth knowing before extending this.

accumulate @ report_error(E), errors(Es) <=> errors([E | Es]).
collect_es @ collect(Out), errors(Es) <=> Out = Es.

% ==========================================================================
% Helpers
% ==========================================================================

% occurs(V, Ty): does the unbound variable V appear anywhere in Ty? Only
% TODO update doc
% ever called on pre-`number_vars` types, whose leaves are `tint` or
% unbound variables, so the `arrow` recursion covers every compound case.
:- function occurs/2.
occurs(V, T) | V == T -> true.
occurs(_, T) | var(T) -> false.
occurs(V, arrow(A, B)) | occurs(V, A) -> true.
occurs(V, arrow(A, B)) -> occurs(V, B).
occurs(_, _) -> false.

number_gd @ phase_dispose_GDs \ generalization_domain(GD, Level) <=>
    % gd_args(GD, Args),
    % number_domain(GD, Level, 0, Args).
    dispose_GD(GD, [], Level).

dispose_GD_var @ dispose_GD(GD, Vars, Level), associate_var(Var, GD) <=> dispose_GD(GD, [Var | Vars], Level).
dispose_GD_end @ dispose_GD(GD, Vars, Level) <=>
    % TODO the following two should be merged to gd_args(GD, Level, Vars) (maybe also incl. length?)
    gd_args(GD, Vars),
    future_assign_tvars(Vars, Level),
    gd_arg_count(GD, length(Vars)).

% number_tvar @ number_domain(GD, Level, Number, Args), level(Var, GD) <=>
%     Var = tvar(Level, Number),
%     % TODO I think doing it like this causes a lot of re-activations.
%     % \ We can instead pass an empty list in `number_gd`, with each `number_tvar` prepending to it, and `number_end` adding a `gd_args`
%     % (Also, it won't be number_*, but rather collect_*, see TODO comment [collect]) (may change name, since there is a `collect` rule)
%     Args = [Var | Rest],
%     NextNumber is Number + 1,
%     number_domain(GD, Level, NextNumber, Rest).
% number_end  @ number_domain(GD, _, _, Args) <=>
%     % TODO maybe also record length of Args?
%     Args = [].

phase_dispose_IDs, gd_args(GD, GDArgs) \ instantiation_domain(ID, VA, GD) <=>
    dispose_ID(ID, VA, [], GDArgs).

dispose_ID_var @ dispose_ID(ID, VA, IVars, [GVar | GVars]), instantiate_ty(ID, IVar, GVar) <=>
    dispose_ID(ID, VA, [IVar | IVars], GVars).
dispose_ID_end @ dispose_ID(ID, VA, IVars, []) <=>
    Reversed is lists:reverse(distinct(IVars)),
    VA = poly_var(Reversed).

phase_number_vars \ future_assign_tvars(Args, Level) <=>
    assign_tvars(Args, Level, 0).

% % TODO change to another prefix instead of typaram
% typaram_let @ start_let_type_args, gd_args(GD, Args) \ instantiation_domain(D, VA, GD) <=>
%     VA = poly_var(A),
%     let_type_args(D, A, Args).
% typaram_var @ let_type_args(D, A, [Arg | Args]) \ instantiate_ty(D, Var, Arg) <=>
%     A = [Var | B],
%     let_type_args(D, B, Args).
% typaram_end @ let_type_args(D, A, []) <=> A = [].

assign_nil  @ assign_tvars([], _, _) <=> true.
assign_cons @ assign_tvars([V | Vs], Level, N) <=>
    V = tvar(Level, N),
    N1 is N + 1,
    assign_tvars(Vs, Level, N1).
