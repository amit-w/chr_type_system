% DOC doc module
:- module(gd, [
    type(generalization_domain/0),
    % creation of GDs
    mk_root/1, mk_child/2,
    % checking descendance
    is_descendant/2,
    % associate unification vars
    associate_var/2, associate_vars/2,
    % dispose GDs & number tyvars
    phase_dispose_GDs/0, phase_number_vars/0,
    gd_args/3
]).

:- use_module(library(prelude)).
:- use_module(library(lists)).

:- use_module(common).
:- use_module(errors).
:- use_module(id).

:- opaque_type generalization_domain.

:- chr_constraint
    mk_root(generalization_domain),
    mk_child(generalization_domain, generalization_domain),
    create_ancestry(generalization_domain, generalization_domain),
    is_descendant(generalization_domain, generalization_domain),
    associate_var(ty, generalization_domain),
    associate_vars(list(ty), generalization_domain),
    generalization_domain(generalization_domain, int),
    gd_args(generalization_domain, int, list(ty)),
    number_domain(generalization_domain, int, int, list(ty)),
    assign_tvars(list(ty), int, int),
    phase_dispose_GDs,
    phase_number_vars,
    dispose_GD(generalization_domain, list(ty), int).

% TITLE creation (+doc)
mk_root(RootGD) <=>
    generalization_domain(RootGD, 0).

generalization_domain(ParentGD, Level) \ mk_child(ChildGD, ParentGD) <=>
    generalization_domain(ChildGD, Level + 1),
    create_ancestry(ChildGD, ParentGD).

% Every ancestor of ParentGD is also an ancestor of ChildGD.
more_ancestry @ create_ancestry(ChildGD, ParentGD), is_descendant(ParentGD, AncestorGD) ==>
    is_descendant(ChildGD, AncestorGD).
% ParentGD is also an ancestor of ChildGD.
ancestry_end  @ create_ancestry(ChildGD, ParentGD) <=> is_descendant(ChildGD, ParentGD).

% ==========================================================================
% Levels: associate_var(Var, Level), associate_vars(Vars, Level)
% ==========================================================================
%
% Every type unification variable (and only them) is associated to a single GD,
% that has the smallest level, from those that it were associated to.
%
% `associate_vars` is used to associate a GD to multiple unification variables.

associate_var_only_variable @ associate_var(V, _) <=> nonvar(V) | true.
associate_var_singleton     @ associate_var(V, GD) \ associate_var(V, GD) <=> true.
associate_var_earliest      @ associate_var(V, AncestorGD), is_descendant(GD, AncestorGD) \ associate_var(V, GD) <=>
    true.
associate_var_collision     @ associate_var(V, GD1), associate_var(V, GD2) ==>
    report_error(quote(gd_collision)).

associate_vars_peel @ associate_vars([V | Vs], Level) <=> associate_var(V, Level), associate_vars(Vs, Level).
associate_vars_end  @ associate_vars([], _) <=> true.

% ==========================================================================
% Helpers
% ==========================================================================
number_gd @ phase_dispose_GDs \ generalization_domain(GD, Level) <=>
    % gd_args(GD, Args),
    % number_domain(GD, Level, 0, Args).
    dispose_GD(GD, [], Level).

dispose_GD_var @ dispose_GD(GD, Vars, Level), associate_var(Var, GD) <=> dispose_GD(GD, [Var | Vars], Level).
dispose_GD_end @ dispose_GD(GD, Vars, Level) <=> gd_args(GD, Level, Vars).

phase_number_vars \ gd_args(_, Level, Args) <=>
    assign_tvars(Args, Level, 0).

assign_nil  @ assign_tvars([], _, _) <=> true.
assign_cons @ assign_tvars([V | Vs], Level, N) <=>
    V = tvar(Level, N),
    N1 is N + 1,
    assign_tvars(Vs, Level, N1).

